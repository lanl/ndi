        ndi -> wardr[label="59) Kerma\nheating\ncalc",
        style=solid, color=green];

        ndi -> caw[label="62) lanl04e",
        style=dotted, color=red];

	morgan -> ndi[label="54) e70act",
	style=dotted, color=red];

        morgan -> ndi[label="61) t2_2009",
        style=dotted, color=red];

        rrcc -> ndi[label="62) lanl04e",
        style=solid, color=green];   

	ndi -> frankles[label="61) t2_2009",
	style=dotted, color=red];

        ndi -> morgan[label="61) Zaid\ntranslation",
        style=solid, color=green];

        ndi -> rsb[label="63) Fission\ntransfer\nmatrix",
