digraph ndi {
	rotate=90;
	page="8.5, 11";
	size="9, 6.5";
	center=1;
	ratio=fill;	
	label="Context Diagram 12/18/09\n\
	solid green=completed work\n\
	dashed orange=ongoing work\n\
	dotted red=future work";
	node[shape="box"];

	/* stakeholders */
        wardr[label="Rob Ward"];
        caw[label="Chuck Wingate"];
        frankles[label="Stephanie Frankle"];
	morgan[label="Morgan White"];
        rrcc[label="Ryan Clement"];
        rsb[label="Randy Baker"];

	/* requirements */
