digraph ndi {
	rotate=90;
	page="8.5, 11";
	size="9, 6.5";
	center=1;
	ratio=fill;	
	label="Context Diagram 04/03/08\n\
	solid green=completed work\n\
	dashed organge=ongoing work\n\
	dotted red=future work";
	node[shape="box"];

	/* stakeholders */
	jimhill[label="Jim Hill"];
	bag[label="Britt Girard"];
	morgan[label="Morgan White"];
	mcaninch1[label="Jeff McAninch"];
	rsb[label="Randy Baker"];
	davidp[label="David Pimentel"];

	/* requirements */
	ndi[label="NDI 2.0.9", shape="ellipse"];
	
	morgan -> ndi[label="22) Multi-Temp.\nMG data",
	style=dashed, color=orange];
	ndi -> rsb[label="22) Multi-Temp.\nMG interface",
	style=solid, color=green];

	ndi -> mcaninch1[label="45) Gendir\nQueries", style=solid,
	color=green];

	ndi -> jimhill[label="46) Spontaneous\nFission Data", style=dashed,
	color=orange];

	ndi-> bag[label="47) Multi-part.\nElementals", style=dotted,
	color=red];

	ndi -> davidp[label="48) Relative\nData Libraries",
	style=dashed, color=orange];

	{rank=min; morgan; rsb; mcaninch1}
	{rank=max; jimhill; bag; davidp}
}
