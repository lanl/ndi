digraph ndi {
	rotate=90;
	page="8.5, 11";
	size="9, 6.5";
	center=1;
	ratio=fill;	
	title="NDI 2.0.7 Context Diagram (07/05/07)"; 
	label="green=completed work\nyellow=ongoing work\nred=future work";
