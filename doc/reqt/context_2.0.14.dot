digraph ndi {
	rotate=90;
	page="8.5, 11";
	size="9, 6.5";
	center=1;
	ratio=fill;	
	label="Context Diagram 09/07/10\n\
	green=completed work\n\
	orange=ongoing work\n\
	red=future work";
	node[shape="box"];

	/* stakeholders */
        dkp[label="Kent Parsons"];
        mbl[label="Beth Lee"];
        rcl[label="Bob Little"];
        caw[label="Chuck Wingate"];
        wardr[label="Rob Ward"];

	/* requirements */
	ndi[label="NDI 2.0.14", shape="ellipse"];
        
        dkp -> ndi[label="54) SN\nlanl2010", style=solid, color=orange];
        ndi -> rcl[label="54) SN\nlanl2010", style=solid, color=red];

        dkp -> ndi[label="68) SN\nkerma", style=solid, color=green];
        ndi -> caw[label="68) SN\nkerma", style=solid, color=green];

        ndi -> caw[label="72) Q_SIG_F", style=solid, color=orange];

        mbl -> ndi[label="73) RC\ncrsdata", style=solid, color=green];
        ndi -> wardr[label="73) RC\ncrsdata", style=solid, color=red];

        dkp -> ndi[label="74) RC\ntests", style=solid, color=green];
        ndi -> wardr[label="74) RC\ntests", style=solid, color=red];

	{rank=min; dkp; mbl}
	{rank=max; rcl; caw; wardr}
}
