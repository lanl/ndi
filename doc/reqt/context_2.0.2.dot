digraph ndi {
	orientation=landscape;
	label="green=past work\nyellow=present work(04/05/05)\nred=future work";
	node[shape="box"];

	/* stakeholders */
	caw[label="Chuck Wingate"];
	dahl[label="Jon Dahl"];
	barcher[label="Bill Archer"];
	jomc[label="Joann Campbell"];
	morgan[label="Morgan White"];

	/* project */
	ndi[label="NDI 2.0.2", shape="ellipse"];
	
	jomc -> ndi[label="14) HR MG Data,\n7) LLNL MG Data", color=yellow4];
	ndi -> jomc[label="7) LLNL MG Support", color=yellow1];
	ndi -> caw[label="16) PD React. ID,\n12) TN Temp. Interp.", color=yellow1];
	ndi -> dahl[label="14) HR MG Data", color=green];
	ndi -> barcher[label="18) Red Storm Support", color=red];
	ndi -> morgan[label="17) Real Multiplicities", color=yellow4];

	{rank = max; jomc; morgan}
	{rank = min; caw; dahl; barcher}
}
