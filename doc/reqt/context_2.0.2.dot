digraph ndi {
	orientation=landscape;
	label="green=past work\nyellow=present work(05/02/05)\nred=future work";
	node[shape="box"];

	/* stakeholders */
	caw[label="Chuck Wingate"];
	dahl[label="Jon Dahl"];
