digraph ndi {
	rotate=90;
	page="8.5, 11";
	size="9, 6.5";
	center=1;
	ratio=fill;	
        label="Context Diagram 12/01/10\n\
	green=completed work\n\
	orange=ongoing work\n\
	red=future work";
	node[shape="box"];

	/* stakeholders */
        mbl[label="Beth Lee"];
        mbchadwick[label="Mark Chadwick"];
        frankles[label="Stephanie Frankle"];
        dahl[label="Jon Dahl"];
        morgan[label="Morgan White"];

	/* requirements */
	ndi[label="NDI 2.0.15", shape="ellipse"];
        
        ndi -> mbchadwick[label="75) Multitemp\nmultiparticle", 
               style=solid, color=orange];

        mbl -> ndi[label="69) PD\nchains", style=solid, color=orange];
        ndi -> frankles[label="69) PD\nchains", style=solid, color=red];

        ndi -> dahl[label="76) e_bounds\nresolution", style=solid,
        color=orange]; 

        ndi -> morgan[label="42) Chi\ncalculations", style=solid, color=orange];
	{rank=min; mbl}
	{rank=max; mbchadwick; frankles; dahl; morgan}
}
