digraph ndi {
	rotate=90;
	page="8.5, 11";
	size="9, 6.5";
	center=1;
	ratio=fill;	
        label="Context Diagram 01/27/11\n\
	green=completed work\n\
	orange=ongoing work\n\
	red=future work";
	node[shape="box"];

	/* stakeholders */
        mbl[label="Beth Lee"];
        mbchadwick[label="Mark Chadwick"];
        frankles[label="Stephanie Frankle"];
        morgan[label="Morgan White"];

	/* requirements */
	ndi[label="NDI 2.0.15", shape="ellipse"];
        
        ndi -> mbchadwick[label="75) Multitemp\nmultiparticle", 
               style=solid, color=green];

        mbl -> ndi[label="69) PD\nchains", style=solid, color=green];
        ndi -> frankles[label="69) PD\nchains", style=solid, color=green];

	ndi -> morgan[label="77) NDI_SEC_PART_ZAIDS", style=solid,
        color=green]; 
	ndi -> morgan[label="42) Chi\ncalculations", style=solid,
        color=green]; 

	{rank=min; mbl}
	{rank=max; mbchadwick; frankles; morgan}
}
