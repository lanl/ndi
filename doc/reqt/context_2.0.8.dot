digraph ndi {
	rotate=90;
	page="8.5, 11";
	size="9, 6.5";
	center=1;
	ratio=fill;	
	label="Context Diagram 10/12/07\n\
	solid green=completed work\n\
	dashed amber=ongoing work\n\
	dotted red=future work";
	node[shape="box"];

	/* stakeholders */
	drnuke[label="Steve Nolen"];
	angelah[label="Angela Herring"];
	morgan[label="Morgan White"];
	jomc[label="Joann Campbell"];
	rsb[label="Randy Baker"];
	dahl[label="Jon Dahl"];

	/* requirements */
	ndi[label="NDI 2.0.8", shape="ellipse"];
	
	angelah -> ndi[label="15) MG scatt.\nMC", style=dotted, color=red];
	ndi -> drnuke[label="15) MG scatt.\nMC", style=dotted, color=red];

	morgan -> ndi[label="22) Multi-Temp.\nMG data",
	style=dotted, color=red];
	ndi -> rsb[label="22) Multi-Temp.\nMG interface",
	style=dashed, color="#FFBF00"];

	ndi -> morgan[label="42) Chi\nMatrix Calc.", style=solid,
	color=green];

	ndi -> dahl[label="43) Multi-part.\nChi Matrix", style=solid,
	color=green];

	ndi-> jomc[label="44) Med-Fi\nGroup Struc", style=solid,
	color=green ];

	{rank=min; angelah; morgan; jomc}
	{rank=max; drnuke; rsb; dahl}
}
