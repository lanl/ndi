digraph ndi {
	rotate=90;
	page="8.5, 11";
	size="9, 6.5";
	center=1;
	ratio=fill;	
	label="NDI 2.0.8 Context Diagram\n(09/17/07)\ngreen=completed work\nyellow=ongoing work\nred=future work";
