        dkp -> ndi[label="78) mendf70x\nSN", color=green];
        mbl -> ndi[label="78) mendf70x\nPD", color=green];
        mgg -> ndi[label="78) mendf70x\nelementals", color=green];

        ndi -> rcl[label="78) mendf70x", color=green];
        ndi -> wardr[label="19) MT\nlabels", color=green]; 
