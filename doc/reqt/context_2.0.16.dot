digraph ndi {
	rotate=90;
	page="8.5, 11";
	size="9, 6.5";
	center=1;
	ratio=fill;	
        label="Context Diagram 08/18/11\n\
	green=completed work\n\
	orange=ongoing work\n\
	red=future work";
	node[shape="box"];

	/* stakeholders */
        mbl[label="Beth Lee"];
        mgg[label="Mark Gray"];
        dkp[label="Kent Parsons\nJeremy Conlin"];
        rcl[label="Bob Little"];
        wardr[label="Rob Ward\nJoann Campbell"]
