dnl Process this file with autoconf to produce a configure script.
AC_INIT(src/ndi_init.c)
AC_CONFIG_AUX_DIR(conf)
AC_CANONICAL_HOST

AC_ARG_WITH(config,
   [  --with-config=CONFIG      set CONFIG.mk])

AC_MSG_CHECKING([makefile configuration include])
if test "${with_config:=no}" = "no" || test "${with_config:=yes}" = yes
then
	case "${host}" in   
	*-ibm-aix*)
		CONFIG=aix
		NDI_ROOT=/usr/gapps/lanl-data/nuclear/ndi
			;;
	sparc-sun-solaris2.*)
		CONFIG=sun
		NDI_ROOT=/usr/local/codes/data/nuclear/ndi
		;;
	i?86-*-linux*)
		CONFIG=intel-linux
		NDI_ROOT=/usr/projects/data/nuclear/ndi
		;;
	x86_64-*-linux*)
		CONFIG=x86_64-linux
		NDI_ROOT=/usr/projects/data/nuclear/ndi
		;;
	mips-sgi-irix*)
		CONFIG=sgi-64
		NDI_ROOT=/usr/projects/data/nuclear/ndi
		;;
	alpha*-dec*)
		CONFIG=alpha-tru64
		NDI_ROOT=/usr/projects/data/nuclear/ndi
		;;
	*)
		AC_MSG_ERROR([Cannot guess CONFIG])
		;;
	esac
else
	if test -f ${srcdir}/conf/${with_config}.mk
	then
		CONFIG=${with_config}
	else
		AC_MSG_ERROR([Cannot find ${with_config}.mk])
	fi
fi
AC_MSG_RESULT([${CONFIG}.mk])
AC_SUBST([CONFIG])

AC_MSG_CHECKING([makefile installation prefix])
AC_PREFIX_DEFAULT(${NDI_ROOT})

if test "${prefix:=/usr/local}" = "/usr/local" -o "${prefix}" = "NONE"
then
	prefix=${NDI_ROOT}
fi
AC_MSG_RESULT([${prefix}])

dnl Checks for programs.

AC_PROG_CC
AC_PROG_CPP
case "$CPP" in
     gcc*)  CPP="$CPP -traditional-cpp";;
esac
AC_PROG_RANLIB
AC_PROG_INSTALL
AC_PROG_AWK
AC_CHECK_PROG(MD5SUM, md5sum, md5sum)

dnl Checks for libraries.

dnl Checks for header files.
AC_HEADER_STDC

dnl Checks for typedefs, structures, and compiler characteristics.
AC_C_CONST
AC_TYPE_SIZE_T

dnl Checks for library functions.
AC_CHECK_FUNCS(strstr strtod strtol)

AC_OUTPUT(GNUmakefile src/GNUmakefile test/GNUmakefile
		      src/test/GNUmakefile src/test/gendir)

test -d src/.dep || mkdir src/.dep
