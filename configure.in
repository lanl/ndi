dnl Process this file with autoconf to produce a configure script.
AC_INIT(src/ndi_init.c)
AC_CONFIG_AUX_DIR(conf)

AC_CANONICAL_HOST

case "${host}" in   
rs6000-ibm-aix*)
	CONFIG=aix
	;;
sparc-sun-solaris2.*)
        CONFIG=sun
	;;
i?86-pc-linux*)
        CONFIG=intel-linux
	;;
ymp-cray-unicos*)
	CONFIG=cray
	;;
mips-sgi-irix*)
	CONFIG=sgi-64
	;;
alphaev67-dec*)
        CONFIG=alpha-tru64
	;;
*)
	AC_MSG_ERROR([Cannot guess CONFIG])
	;;
esac

AC_SUBST([CONFIG])

dnl Checks for programs.

AC_PROG_CC
AC_PROG_RANLIB
AC_PROG_INSTALL

dnl Checks for libraries.

dnl Checks for header files.
AC_HEADER_STDC

dnl Checks for typedefs, structures, and compiler characteristics.
AC_C_CONST
AC_TYPE_SIZE_T

dnl Checks for library functions.
AC_CHECK_FUNCS(strstr strtod strtol)

AC_OUTPUT(makefile src/makefile)

test -d src/.dep || mkdir src/.dep
test -d src/test || mkdir src/test
