SRC_TESTF := \
	test/ex_avg_ef.F \
	test/ex_gendir_pathf.F \
	test/ex_kerma1f.F \
	test/ex_kerma2f.F  \
	test/f_handlef.F \
	test/f_handlef2.F \
	test/gendir_pathf.F \
	test/library_checkf.F \
	test/mpmgf.F \
	test/mpmg2f.F \
	test/ndi_testf.F\
	test/ndi_testf2.F\
	test/ndidf.F\
	test/radchemf.F\
	test/symbol_translatef.F 

DATA_TEST_SRC := \
	test/mgn_data.c \
	test/tn_data.c \
	test/dosn_data.c \
	test/proddepl_data.c \
	test/tnreac_data.c \
	test/radchem_data.c 

ifneq (,$(findstring cray, $(CONFIG)))
SRC += ndi_fortran_cray.c
else
SRC += ndi_fortran.c
endif

# determine the object files

OBJ 	:= 
OBJ	+= $(SRC:%.c=%.o)
OBJ	+= $(SRC_FLOAT:%.c=%_float32.o)
OBJ	+= $(SRC_FLOAT:%.c=%_float64.o)

OBJ_TESTC:=  test/all.o $(SRC_TESTC:%.c=%.o)
TESTC	:=  testc_all $(SRC_TESTC:test/%.c=testc_%)
TESTF	:=  $(SRC_TESTF:test/%.F=testf_%)
DATA_TESTS	:= $(DATA_TEST_SRC:test/%.c=testc_%)

# determine test output files

TESTOUT	:=
TESTOUT	+= $(SRC_TESTC:test/%.c=testc_%.out)
TESTOUT	+= $(SRC_TESTF:test/%.F=testf_%.out)

# determine dependency files

DEPENDENCIES 	:= 
DEPENDENCIES	+= $(SRC:%.c=.dep/%.d)
DEPENDENCIES	+= $(SRC_FLOAT:%.c=.dep/%_float32.d)
DEPENDENCIES	+= $(SRC_FLOAT:%.c=.dep/%_float64.d)

# target rules

all: $(TARGET)

check: $(TARGET) $(TESTOUT)
	@ for i in $(TESTOUT) ; \
	do  \
	if (perl $(srcdir)/test/fcmp.pl $$i $(srcdir)/test/output/$$i); \
	then \
	echo PASSED: $$i ; \
	else \
	echo *****TEST FAILED:  $$i ; \
	fi ; \
	done

check_all: $(TARGET) $(TESTC) $(TESTF)
	echo "Insert commands to run the tests here"

check_data: $(TARGET) $(DATA_TESTS)
	@ $(RM) $@.out
	@ for i in $(DATA_TESTS); \
	do \
	$$i >> $@.out; \
	rm $$i; \
	done

clean:
	$(RM) $(OBJ) $(DEPENDENCIES) $(OBJ_TESTC) $(TESTC) $(TESTF)

distclean: clean
	$(RM) $(TARGET) $(VERSION) $(FMANGLE) $(VAR_TYPE) $(TESTOUT) \
	$(DATA_TESTS) check_data.out 

testclean:
	$(RM) $(TESTC) $(TESTF) $(TESTOUT) $(DATA_TESTS) check_data.out

install: all
	umask 002 ; \
	$(INSTALL) -g $(GROUP) -m 775 -d $(includedir) ; \
	$(INSTALL) -g $(GROUP) -m 775 -d $(libdir) ; \
	$(INSTALL) -g $(GROUP) -m 664 libndi.a $(libdir) ; \
	$(INSTALL) -g $(GROUP) -m 664 $(srcdir)/ndi.h $(includedir) ; \
	$(INSTALL) -g $(GROUP) -m 664 $(srcdir)/ndi_keywords.h $(includedir) ; \
	$(INSTALL) -g $(GROUP) -m 664 ndi_keywords.i $(includedir) ; \
	$(INSTALL) -g $(GROUP) -m 664 ndi_var_type.h $(includedir)

libndi.a: $(VERSION) $(FMANGLE) $(VAR_TYPE) $(OBJ)
	$(AR) $(ARFLAGS) $@ $(OBJ)
	$(RANLIB) $@

$(VERSION): VERSION
	echo '#define NDI_VERSION_DATA "'`cat $(srcdir)/VERSION`'"' > $@

$(VAR_TYPE): ndi_define_float.c
	@echo Making $(VAR_TYPE)
	$(RM) ndi_define_float
	$(CC) $(CFLAGS) -I$(srcdir) $(CPPFLAGS) -o ndi_define_float \
	$(srcdir)/ndi_define_float.c
	ndi_define_float > $@
	$(RM) ndi_define_float

$(FMANGLE): fcallscc.c fcallscf.f ndi_keywords.i
	@echo Making $(FMANGLE)
	$(RM) f_calls_c
	$(CC) -c $(CFLAGS) -I$(srcdir) $(CPPFLAGS) $(srcdir)/fcallscc.c
	$(FC) -c $(FFLAGS) -I$(srcdir) $(srcdir)/fcallscf.f
	$(FC) $(FFLAGS) -I$(srcdir) -o f_calls_c fcallscf.o fcallscc.o
	f_calls_c > $@
	$(RM) f_calls_c fcallscc.o fcallscf.o

testc_all: $(TARGET) $(OBJ_TESTC)
	$(CC) $(CFLAGS) -I$(srcdir) $(CPPFLAGS) $(LDFLAGS) $(OBJ_TESTC) -o $@ $(LDLIBS)

ndi_keywords.i: ndi_keywords.h
	$(AWK) -f $(srcdir)/keywords.awk $(srcdir)/ndi_keywords.h > ndi_keywords.i

ndi.md: $(SRC)
	$(MD5SUM) $(srcdir)/*.[ch] > ndi.md

ndi.sv: 
	$(MD5SUM) --check ndi.md

# pattern rules

testc_%: $(TARGET)

testc_%: test/%.c
	$(CC) $(CFLAGS) -I$(srcdir) $(CPPFLAGS) $(LDFLAGS) $(STANDALONE_FLAG) -o $@ $< $(LDLIBS)

testf_%: $(TARGET)

testf_%: test/%.F
	$(CPP) -P -I$(srcdir) $(CPPFLAGS) $< > $@.f 
	$(FC) $(FFLAGS) -I$(srcdir) $(LDFLAGS) -o $@ $@.f $(LDLIBS)

test/%.o: test/%.c
	$(CC) $(CFLAGS) -I$(srcdir) $(CPPFLAGS) -c -o $@ $<

test%.out:  test%
	NDI_GENDIR_PATH=$(testlib)/gendir.test $< > $@ 2>&1

%.o: %.c
	$(CC) $(CFLAGS) -I$(srcdir) $(CPPFLAGS) $(NO_NAME_SUB_FLAG) -c -o $@ $<

%.o: %.f
	$(FC) $(FFLAGS) -c -o $@ $<

%.o: %.F
	$(CPP) -P -I$(srcdir) $(CPPFLAGS) $< > $@.f 
	$(FC) $(FFLAGS) -I$(srcdir) -c -o $@ $<

%_float32.o: %.c
	$(CC) $(CFLAGS) -I$(srcdir) $(CPPFLAGS) $(FLOAT32FLAGS) -c -o $@ $<

%_float64.o: %.c
	$(CC) $(CFLAGS) -I$(srcdir) $(CPPFLAGS) $(FLOAT64FLAGS) -c -o $@ $<


# include dependency files, if we were not invoked as "make clean"
# or "make distclean"

ifneq ($(findstring clean, $(MAKECMDGOALS)),clean)
-include $(DEPENDENCIES)
endif

# rules for calculating dependency files

.dep/%.d: %.c $(VERSION) $(FMANGLE) $(VAR_TYPE)
	$(DEP) -I$(srcdir) $(CPPFLAGS) $(NO_NAME_SUB_FLAG) $< | sed  -e 's@^.*\.o:@$*.o $*.d:@' > $@

.dep/%_float32.d: %.c $(VERSION) $(FMANGLE) $(VAR_TYPE)
	$(DEP) -I$(srcdir) $(CPPFLAGS) $(NO_NAME_SUB_FLAG) $(FLOAT32FLAGS) $< | sed  -e 's@^.*\.o:@$*_float32.o $*_float32.d:@' > $@

.dep/%_float64.d: %.c $(VERSION) $(FMANGLE) $(VAR_TYPE)
	$(DEP) -I$(srcdir) $(CPPFLAGS) $(NO_NAME_SUB_FLAG) $(FLOAT64FLAGS) $< | sed  -e 's@^.*\.o:@$*_float64.o $*_float64.d:@' > $@
