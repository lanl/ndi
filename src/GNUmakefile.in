######################################################################
#
# Second-level make file for NDI
# 
# This make file does the real work, but probably you should be
# calling this from the make file in the directory above.
#
#   $Id$
#
######################################################################

.PHONY:		all check clean distclean install

vpath %.c @srcdir@
vpath %.h @srcdir@
vpath %.f @srcdir@
vpath %.F @srcdir@

SHELL		= /bin/sh

CONFIG		= @CONFIG@
top_srcdir	= @top_srcdir@
srcdir		= @srcdir@
prefix		= @prefix@

VERSION		= $(shell head -1 $(top_srcdir)/VERSION)
libdir		= $(prefix)/$(VERSION)/$(CONFIG)/lib
includedir	= $(prefix)/$(VERSION)/$(CONFIG)/include

DEP		= gcc -MM
CPP		= @CPP@
RANLIB		= @RANLIB@
INSTALL		= @INSTALL@
AWK		= @AWK@
MD5SUM		= @MD5SUM@

GROUP		:= pdata

INSTALL_DIR	= $(INSTALL) -g $(GROUP) -m 775 -d
INSTALL_LIB	= $(INSTALL) -g $(GROUP) -m 644

######################################################################

# configuration selection is based on the variable CONFIG

include $(top_srcdir)/conf/$(CONFIG).mk

######################################################################

TARGET := libndi.a libndi_debug.a

SRC := \
	ndi_avail.c \
	ndi_bin_tree.c \
	ndi_check_option.c \
	ndi_close.c \
	ndi_close_lib_file.c \
	ndi_c_values.c \
	ndid_get_size.c \
	ndid_get_string_vec.c \
	ndi_element_index.c \
	ndi_fill_element.c \
	ndi_find_index.c \
	ndi_free.c \
	ndi_get_int_val.c \
	ndi_get_int_val_n.c \
	ndi_get_int_vec.c \
	ndi_get_int_vec_n.c \
	ndi_get_int_vec_x.c \
	ndi_get_size.c \
	ndi_get_size_n.c \
	ndi_get_size_x.c \
	ndi_get_string_val.c \
	ndi_get_string_val_n.c \
	ndi_get_string_vec.c \
	ndi_handle.c \
	ndi_init.c \
	ndi_init_iso_state.c \
	ndi_init_state.c \
	ndi_interp_integ.c \
	ndi_malloc.c \
	ndi_misc.c \
	ndi_misc_depl.c \
	ndi_open_gendir.c \
	ndi_open_lib_file.c \
	ndi_parse_zaid.c \
	ndi_read_dir_block.c \
	ndi_read_int_block.c \
	ndi_read_rx_prod.c \
	ndi_read_string_block.c \
	ndi_set0.c \
	ndi_set_e_grps.c \
	ndi_set_isotope.c \
	ndi_set_float_vec_option.c \
	ndi_set_option.c \
	ndi_skip_rx_prod.c \
	ndi_skip_float_block.c \
	ndi_state.c \
	ndi_std_zaid.c \
	ndi_sza_symbol_translation.c \
	ndi_user_functions_handles.c \
	ndi_user_functions_no_h.c \
	ndi_zaid_dir.c \
	ndimp_get_int_val.c \
	ndimp_get_int_val_n.c \
	ndimp_get_int_vec.c \
	ndimp_get_size.c \
	ndimp_get_size_n.c \
	ndimp_get_string_val.c \
	ndimp_set_option.c \
	ndimp_set_zaid.c 

SRC_FLOAT := \
	ndi_collapse_float.c \
	ndi_collapse_mat.c \
	ndi_get_float_val.c \
	ndi_get_float_val_n.c \
	ndi_get_float_vec.c \
	ndi_get_float_vec_n.c \
	ndi_get_float_vec_x.c \
	ndi_misc_float.c \
	ndi_read_float_block.c \
	ndid_zaid_float_vec.c \
	ndimp_get_float_vec.c \
	ndimp_get_float_vec_n.c 

ifneq (,$(findstring cray, $(CONFIG)))
SRC += ndi_fortran_cray.c
else
SRC += ndi_fortran.c
endif

# determine the object files

OBJ 	:= 
OBJ	+= $(SRC:%.c=%.o)
OBJ	+= $(SRC_FLOAT:%.c=%_float32.o)
OBJ	+= $(SRC_FLOAT:%.c=%_float64.o)

OBJ_D 	:= 
OBJ_D	+= $(SRC:%.c=%_debug.o)
OBJ_D	+= $(SRC_FLOAT:%.c=%_float32_debug.o)
OBJ_D	+= $(SRC_FLOAT:%.c=%_float64_debug.o)

# determine dependency files

DEPENDENCIES 	:= 
DEPENDENCIES	+= $(SRC:%.c=.dep/%.d)
DEPENDENCIES	+= $(SRC_FLOAT:%.c=.dep/%_float32.d)
DEPENDENCIES	+= $(SRC_FLOAT:%.c=.dep/%_float64.d)

# target rules

all: $(TARGET)

clean:
	$(RM) $(OBJ) $(DEPENDENCIES) 

distclean: clean
	$(RM) $(TARGET) fmangle.h ndi_var_type.h

install: all
	umask 022 ; \
	$(INSTALL_DIR) $(includedir) ; \
	$(INSTALL_DIR) $(libdir) ; \
	$(INSTALL_LIB) libndi.a $(libdir) ; \
	$(INSTALL_LIB) libndi_debug.a $(libdir) ; \
	$(INSTALL_LIB) $(srcdir)/ndi.h $(includedir) ; \
	$(INSTALL_LIB) $(srcdir)/ndi_keywords.h $(includedir) ; \
	$(INSTALL_LIB) ndi_keywords.i $(includedir) ; \
	$(INSTALL_LIB) ndi_var_type.h $(includedir)

libndi.a: ndi_version.h fmangle.h ndi_var_type.h $(OBJ)
	$(AR) $(ARFLAGS) $@ $(OBJ)
	$(RANLIB) $@

libndi_debug.a: ndi_version.h fmangle.h ndi_var_type.h $(OBJ_D)
	$(AR) $(ARFLAGS) $@ $(OBJ_D)
	$(RANLIB) $@

$(srcdir)/ndi_version.h: $(top_srcdir)/VERSION
	echo '#define NDI_VERSION_DATA "'`cat $(top_srcdir)/VERSION`'"' > $@

ndi_var_type.h: ndi_define_float.c
	@echo Making ndi_var_type.h
	$(RM) ndi_define_float
	$(CC) $(CFLAGS) -I$(srcdir) $(CPPFLAGS) -o ndi_define_float \
	$(srcdir)/ndi_define_float.c
	./ndi_define_float > $@
	$(RM) ndi_define_float

fmangle.h: fcallscc.c fcallscf.f ndi_keywords.i
	@echo Making fmangle.h
	$(RM) f_calls_c
	$(CC) -c $(CFLAGS) -I$(srcdir) $(CPPFLAGS) $(srcdir)/fcallscc.c
	$(FC) -c $(FFLAGS) -I$(srcdir) $(srcdir)/fcallscf.f
	$(FC) $(FFLAGS) -I$(srcdir) -o f_calls_c fcallscf.o fcallscc.o
	./f_calls_c > $@
	$(RM) f_calls_c fcallscc.o fcallscf.o


ndi_keywords.i: ndi_keywords.h
	$(AWK) -f $(srcdir)/keywords.awk $(srcdir)/ndi_keywords.h > ndi_keywords.i

ndi.md: $(SRC)
	$(MD5SUM) $(srcdir)/*.[ch] > ndi.md

ndi.sv: 
	$(MD5SUM) --check ndi.md

GNUmakefile: $(srcdir)/GNUmakefile.in $(top_srcdir)/config.status
	cd $(top_srcdir) && ./config.status

# pattern rules

%.o: %.f
	$(FC) $(FFLAGS) -c -o $@ $<

%.o: %.F
	$(CPP) -P -I$(srcdir) $(CPPFLAGS) $< > $@.f 
	$(FC) $(FFLAGS) -I$(srcdir) -c -o $@ $<

%.o: %.c
	$(CC) $(CFLAGS) -O -DNDEBUG -I$(srcdir) $(CPPFLAGS) $(NO_NAME_SUB_FLAG) -c -o $@ $<

%_float32.o: %.c
	$(CC) $(CFLAGS) -O -I$(srcdir) $(CPPFLAGS) $(FLOAT32FLAGS) -c -o $@ $<

%_float64.o: %.c
	$(CC) $(CFLAGS) -O -I$(srcdir) $(CPPFLAGS) $(FLOAT64FLAGS) -c -o $@ $<

%_debug.o: %.c
	$(CC) $(CFLAGS) -g -I$(srcdir) $(CPPFLAGS) $(NO_NAME_SUB_FLAG) -c -o $@ $<

%_float32_debug.o: %.c
	$(CC) $(CFLAGS) -g -I$(srcdir) $(CPPFLAGS) $(FLOAT32FLAGS) -c -o $@ $<

%_float64_debug.o: %.c
	$(CC) $(CFLAGS) -g -I$(srcdir) $(CPPFLAGS) $(FLOAT64FLAGS) -c -o $@ $<


# include dependency files, if we were not invoked as "make clean"
# or "make distclean"

ifneq ($(findstring clean, $(MAKECMDGOALS)),clean)
-include $(DEPENDENCIES)
endif

# rules for calculating dependency files

.dep/%.d: %.c ndi_version.h fmangle.h ndi_var_type.h
	$(DEP) -I$(srcdir) $(CPPFLAGS) $(NO_NAME_SUB_FLAG) $< | sed  -e 's@^.*\.o:@$*.o $*.d:@' > $@

.dep/%_float32.d: %.c ndi_version.h fmangle.h ndi_var_type.h
	$(DEP) -I$(srcdir) $(CPPFLAGS) $(NO_NAME_SUB_FLAG) $(FLOAT32FLAGS) $< | sed  -e 's@^.*\.o:@$*_float32.o $*_float32.d:@' > $@

.dep/%_float64.d: %.c ndi_version.h fmangle.h ndi_var_type.h
	$(DEP) -I$(srcdir) $(CPPFLAGS) $(NO_NAME_SUB_FLAG) $(FLOAT64FLAGS) $< | sed  -e 's@^.*\.o:@$*_float64.o $*_float64.d:@' > $@

######################################################################
