######################################################################
#
# Top-level makefile for NDI
#
######################################################################

.PHONY: all check install clean distclean

######################################################################

SHELL		= /bin/sh

######################################################################

all:
	(cd src; $(MAKE) all)

check:
	(cd src; $(MAKE) check)

install:
	(cd src; $(MAKE) install)

clean:
	(cd src; $(MAKE) clean)

distclean:
	(cd src; $(MAKE) distclean)
	$(RM) Makefile config.log config.status

check_data:
	(cd src; $(MAKE) check_data)
