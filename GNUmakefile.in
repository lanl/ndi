######################################################################
#
# Top-level makefile for NDI
#
######################################################################

.PHONY: all check install clean distclean

######################################################################

SHELL		= /bin/sh
VPATH		= @srcdir@

srcdir		= @srcdir@
top_srcdir	= @top_srcdir@
prefix		= @prefix@
CONFIG		= @CONFIG@
VERSION		= $(shell head -1 $(srcdir)/VERSION)

######################################################################

all:
	(cd src; $(MAKE) all)

check:
	(cd src/test; $(MAKE) check)

install:
	(cd src; $(MAKE) install)

checkinstall:
	(cd test; $(MAKE) checkinstall)

clean:
	(cd src; $(MAKE) clean)
	(cd test; $(MAKE) clean)

distclean:
	(cd src; $(MAKE) distclean)
	(cd test; $(MAKE) distclean)
	$(RM) Makefile config.log config.status
	$(RM) -fr autom4e.cache

$(srcdir)/configure: configure.in
	cd $(srcdir) && autoconf

GNUmakefile: GNUmakefile.in config.status
	./config.status

config.status: configure
	./config.status --recheck

print_install:
	@echo $(prefix)/$(VERSION)/$(CONFIG)
