######################################################################
#
# Top-level makefile for NDI
#
######################################################################

.PHONY: all check install clean distclean

######################################################################

SHELL		= /bin/sh

######################################################################

all:
	(cd src; $(MAKE) all)

check:
	(cd src; $(MAKE) check)

install:
	(cd src; $(MAKE) install)

check_install:
	(cd test; $(MAKE) check_install)

clean:
	(cd src; $(MAKE) clean)
	(cd test; $(MAKE) clean)

distclean:
	(cd src; $(MAKE) distclean)
	(cd test; $(MAKE) distclean)
	$(RM) Makefile config.log config.status
	$(RM) -fr autom4e.cache
