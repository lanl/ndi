# Build rule for target.
ndi.tnreac_c: cmake_check_build_system
	$(MAKE) $(MAKESILENT) -f CMakeFiles/Makefile2 ndi.tnreac_c
.PHONY : ndi.tnreac_c

# fast build rule for target.
ndi.tnreac_c/fast:
	$(MAKE) $(MAKESILENT) -f src/test/CMakeFiles/ndi.tnreac_c.dir/build.make src/test/CMakeFiles/ndi.tnreac_c.dir/build
.PHONY : ndi.tnreac_c/fast

